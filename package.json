{
  "name": "house-for-rent",
  "version": "1.0.0",
  "private": true,
  "description": "House For Rent \u2014 a trust-first residential rental marketplace for Natural Intellects Ltd (Uganda).",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "api": "npm run start:dev --workspace @hfr/api",
    "api:build": "npm run build --workspace @hfr/api",
    "api:test": "npm run test --workspace @hfr/api",
    "web": "npm run dev --workspace @hfr/web",
    "web:build": "npm run build --workspace @hfr/web",
    "web:start": "npm run start --workspace @hfr/web",
    "web:e2e": "npm run test:e2e --workspace @hfr/web",
    "seed:demo": "npm run seed:demo --workspace @hfr/api",
    "migrate": "npm run migrate --workspace @hfr/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @hfr/api",
    "build": "npm run web:build"
  },
  "engines": {
    "node": ">=20"
  }
}
