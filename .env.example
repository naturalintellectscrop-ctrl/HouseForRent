# House For Rent — environment template (variable NAMES only; never commit real values)

# Copy to .env (local dev) and fill in. Production credentials live only in
# the deployment platform's environment settings — never in the repository.
# See docs/DEVELOPER_ONBOARDING.md and docs/ARCHITECTURE.md §9 for details.

# --- Runtime ---------------------------------------------------------------
# PostgreSQL connection string (Prisma). Local dev: scripts/dev-local-stack.mjs
# prints the local URL. Production: Supabase pooler URL (the client in
# src/lib/db.ts hardens pooler URLs automatically).
DATABASE_URL=
# NODE_ENV is set by the platform (development|production).
# Canonical site URL for SEO metadata/sitemap; falls back to the deployed URL.
NEXT_PUBLIC_SITE_URL=
# Set to anything to enable Prisma query logging (opt-in debugging).
DEBUG_QUERIES=

# --- NylonPay (payment provider) -------------------------------------------
# Live mode requires ALL THREE credentials; anything less safely falls back
# to the sandbox mock (self-labelled in the ledger).
NYLONPAY_API_KEY=
NYLONPAY_API_SECRET=
NYLONPAY_WEBHOOK_SECRET=
# live | sandbox (unset = sandbox mock)
NYLONPAY_MODE=
# Optional provider base-URL override.
NYLONPAY_BASE_URL=

# --- Media storage ----------------------------------------------------------
# local | supabase (unset: supabase when SUPABASE_URL + key exist, else local)
MEDIA_STORAGE=
# Supabase Storage adapter credentials (private bucket).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=
# Local adapter root (default: <cwd>/media).
MEDIA_ROOT=
# Upload byte cap (default: 4000000).
MEDIA_MAX_BYTES=
