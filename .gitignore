# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log

# Anchored deliberately. As bare patterns, `test` and `prompt` matched a
# directory of that name at ANY depth — which silently excluded
# `apps/api/test/` from version control.
/test
/prompt

server.log
# Skills directory
/skills/

# Uploaded files
/public/uploads/

# Playwright
test-results/
playwright-report/
apps/web/shots/

# Listing photographs.
#
# `PhotoStore` writes bytes here (MEDIA_ROOT, default `apps/api/var/media`).
# They are NOT committed: the demo set is regenerated deterministically by
# `scripts/seed-web-demo.mjs`, and real officer photography belongs on a
# persistent disk or an object store, never in git history.
apps/api/var/
