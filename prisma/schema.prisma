// House For Rent V1 — PRODUCTION DOMAIN SCHEMA (PostgreSQL).
//
// This is the real repository's schema (recovered from the v0 lineage in git
// history, apps/api/prisma/schema.prisma @ 2efa53f) and it EXACTLY matches
// the owner's live Supabase database. Parity re-verified after the 2026-10-23
// project resumption with `prisma migrate diff` (read-only): 33 models, all
// enums/columns identical, zero drift; the only DB-side extras are the
// out-of-band tables (ba_*, _applied_migrations — see
// scripts/recovery-out-of-band-tables.sql) and the SavedListing listing_id
// index, now declared below. NOTE: the historical prisma/migrations folder is
// no longer present in the repo — the immutability triggers it installed LIVE
// ON PRODUCTION (verified via pg_trigger, 11 append-only tables + the
// conducted-viewing evidence gate) and their SQL is preserved in git history
// (migration 20260727150100_immutable_tables).
//
// ── RULES THAT KEEP THE BUSINESS DATA ALIVE ──
//   1. NEVER run `prisma db push` or `prisma migrate reset` against
//      DATABASE_URL pointing at Supabase — the database holds the company's
//      real records (parties, listings, deals, ledger) AND database-level
//      immutability triggers. Schema changes go through migrations reviewed
//      by the owner, never a push.
//   2. Append-only tables (🔒 below) are guarded by BEFORE UPDATE OR DELETE
//      triggers that raise on ANY mutation — corrections are new rows.
//      Trigger SQL lives in git history
//      (prisma/migrations/20260727150100_immutable_tables/migration.sql).
//   3. PspInstruction.state is the INITIAL state only; current state is the
//      toState of the latest PspInstructionEvent (deduped per (instruction, state)).
//
// The former SQLite sandbox adaptation of this schema is preserved in git
// history (sandbox/webapp lineage up to 760d8cd) together with the QA
// harness built on it.
// Source of truth: /docs/House_For_Rent_Data_Model.md. Do not diverge from it
// without a flagged, confirmed decision — see /docs/DOMAIN.md for the mapping
// of every model back to its SSOT decision(s).
//
// Conventions carried over from Data_Model.md:
//   - All money is Int/BigInt shillings. Never Float/Decimal for money.
//   - 🔒 in a comment marks an immutable table. Enforced at the DATABASE level
//     by a BEFORE UPDATE OR DELETE trigger (see
//     prisma/migrations/*_immutable_tables/migration.sql) that raises an
//     exception regardless of which role or code path issues the write —
//     not merely a service-layer convention. Corrections are new rows.
//   - ⟡ in a comment marks a seam field: V1 constrains it to a single value via
//     enum + check constraint / application validation, but future values are
//     addable without migrating existing rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

// ============================================================================
// Identity & Verification module (Data_Model.md §2)
// ============================================================================

/// Account lifecycle states.
///
/// `active`, `suspended` and `closed` are the original SSOT set.
/// `pending_verification`, `disabled` and `archived` were added for the
/// auth-hardening pass; they are additive enum values, so no existing row
/// changes meaning and no data migrates.
///
/// What each one MEANS is defined once, in `AccountStatusPolicy`
/// (src/auth/account-status.ts), and enforced at login. A status column
/// nothing checks is documentation, not a control — which is exactly what
/// this was before that policy existed.
enum PartyStatus {
  /// Registered but not yet identity-verified. CAN sign in — a tenant must
  /// be able to reach the app in order to complete verification.
  pending_verification
  active
  /// Temporarily blocked by ops. Cannot sign in; reversible.
  suspended
  /// Blocked and not expected to return. Cannot sign in.
  disabled
  /// Retained for audit/retention only (DPA 2019). Cannot sign in.
  archived
  /// Original SSOT value, retained so existing rows keep their meaning.
  closed
}

/// The product-agnostic actor. A party may be a tenant, lister, FOO, or admin —
/// role is contextual (via user_account.auth_role), not a fixed column, because
/// one human could be both a tenant and a landlord. (SSOT Decision 8; Technical
/// Architecture §4.1)
model Party {
  id           String      @id @default(uuid())
  displayName  String      @map("display_name")
  primaryPhone String      @unique @map("primary_phone")
  /// ADDITIVE (platform-owner access, Task 39): optional email identifier,
  /// applied to the live database with CREATE COLUMN IF NOT EXISTS + a unique
  /// index — no pre-existing row is touched (same precedent as SavedListing,
  /// Task 26). Nullable because phone remains the primary identity primitive;
  /// sign-in resolves either identifier. No email is collected at self-service
  /// registration in V1, so only provisioned accounts (the platform owner)
  /// carry a value.
  email        String?     @unique
  status       PartyStatus @default(active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  userAccounts          UserAccount[]
  listerProfile         ListerProfile?
  identityVerifications IdentityVerification[]
  consentRecords        ConsentRecord[]

  mandatesAsLister   PropertyMandate[] @relation("MandateLister")
  mandatesVerifiedBy PropertyMandate[] @relation("MandateVerifier")

  /// Landlord onboarding KYC (additive, consolidated round 2026-10-29):
  /// applications this party submitted and review decisions they took.
  landlordKycSubmissions LandlordKyc[] @relation("KycApplicant")
  landlordKycReviews     LandlordKyc[] @relation("KycReviewer")

  propertiesOwned Property[]

  viewingsAsTenant Viewing[] @relation("ViewingTenant")
  viewingsAsFoo    Viewing[] @relation("ViewingFoo")

  introductionsAsTenant   IntroductionRecord[] @relation("IntroTenant")
  introductionsAsLandlord IntroductionRecord[] @relation("IntroLandlord")
  introductionsAsFoo      IntroductionRecord[] @relation("IntroFoo")

  fieldReports FieldReport[]

  screeningRuns ScreeningRun[]

  dealsAsTenant   Deal[]           @relation("DealTenant")
  dealsAsLandlord Deal[]           @relation("DealLandlord")
  dealTransitions DealTransition[]

  ledgerAccounts LedgerAccount[]

  configVersionsCreated         ConfigVersion[]
  commissionRateVersionsCreated CommissionRateVersion[]

  listingAgreements ListingAgreement[]

  mediaAssetsUploaded MediaAsset[]

  auditEvents AuditEvent[]

  /// Sandbox-era feature carried into production (additive): a tenant's
  /// saved homes. Backing table created additively in Supabase — see
  /// worklog Task 26. Touches no pre-existing table.
  savedListings SavedListing[]

  @@map("party")
}

enum AuthRole {
  tenant
  lister
  foo
  admin
}

/// Auth binding for a party. Kept separate from Party so a party can exist
/// (e.g. a landlord created by ops) before self-service credentials. V1: one
/// primary role per account (Data_Model.md §2.2).
model UserAccount {
  id          String    @id @default(uuid())
  partyId     String    @map("party_id")
  authRole    AuthRole  @map("auth_role")
  /// Set on each successful login. Nullable because an account that has
  /// never signed in genuinely has no value — a sentinel date would make
  /// "never" indistinguishable from "long ago".
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  party          Party                @relation(fields: [partyId], references: [id])
  sessions       Session[]
  credential     UserCredential?
  passwordResets PasswordResetToken[]

  @@map("user_account")
}

/// Password reset tokens.
///
/// ── Why hashed, single-use and short-lived ──
/// A reset token is a credential that bypasses the password entirely, so it
/// is stored as a SHA-256 hash exactly like a refresh token: a database
/// disclosure must not hand over the ability to take over accounts. It is
/// consumed on use (`usedAt`) and expires quickly — the same reasoning that
/// makes refresh tokens rotate.
///
/// ── Why deliberately NOT immutable ──
/// Unlike the 🔒 tables, this row is legitimately mutated (marking it used)
/// and legitimately deleted (expiry cleanup). Marking it immutable would be
/// wrong rather than merely unnecessary — the same call already recorded
/// for `session` in DOMAIN.md.
model PasswordResetToken {
  id            String    @id @default(uuid())
  userAccountId String    @map("user_account_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])

  @@index([userAccountId])
  @@map("password_reset_token")
}

/// Credential store. Data_Model.md §2.2 deliberately models no password
/// columns on `user_account`, noting "credentials handled by auth
/// subsystem" and leaving the shape to document 4 — this is that decision.
///
/// Kept in its own table rather than as columns on `user_account` so that
/// reading an account (which happens on every authorised request) never
/// loads the password hash, and so a future switch to a different
/// credential type (OTP-only, WebAuthn) adds a table rather than migrating
/// the account row. Only the bcrypt hash is stored; the password itself
/// never touches the database.
model UserCredential {
  id            String   @id @default(uuid())
  userAccountId String   @unique @map("user_account_id")
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])

  @@map("user_credential")
}

/// Standard session/refresh record (Data_Model.md §2.3 — "fields per auth
/// choice, not detailed there"). Minimal V1 shape: an opaque refresh-token
/// hash + expiry, revocable. Not immutable — sessions are legitimately
/// mutated (revoked) and deleted (expiry cleanup); this is intentionally
/// outside the 🔒 set.
model Session {
  id               String    @id @default(uuid())
  userAccountId    String    @map("user_account_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])

  @@index([userAccountId])
  @@map("session")
}

enum ListerTier {
  property_owner
  broker_agent
  property_mgmt_company
}

/// Tier drives verification + mandate requirements (FR-1.1, FR-3.2; SSOT
/// Decision 8). One profile per party.
model ListerProfile {
  id        String     @id @default(uuid())
  partyId   String     @unique @map("party_id")
  tier      ListerTier
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  party Party @relation(fields: [partyId], references: [id])

  @@map("lister_profile")
}

enum IdentityMethod {
  nin
  phone
  selfie_match
}

enum VerificationState {
  pending
  verified
  failed
}

/// Identity = who a party is. SEPARATE from mandate (Technical Architecture
/// §4.1). One row per verification attempt; current state derivable from the
/// latest row per (party, method). A party is "identity-verified" when it has
/// a 'verified' row for each required method (nin, phone, selfie_match).
///
/// No plaintext NIN is stored here — the raw NIN is handled by the
/// IdentityProvider boundary; only verification state and an opaque
/// provider_ref persist (DPA 2019 data minimisation, NFR-3).
model IdentityVerification {
  id          String            @id @default(uuid())
  partyId     String            @map("party_id")
  method      IdentityMethod
  state       VerificationState @default(pending)
  providerRef String?           @map("provider_ref")
  verifiedAt  DateTime?         @map("verified_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  party Party @relation(fields: [partyId], references: [id])

  @@index([partyId, method])
  @@map("identity_verification")
}

/// 🔒 Immutable: consent is a historical fact. Withdrawal is a new row with a
/// 'consent_withdrawal' purpose, never an edit (DPA 2019).
model ConsentRecord {
  id             String    @id @default(uuid())
  partyId        String    @map("party_id")
  purpose        String
  grantedAt      DateTime  @map("granted_at")
  retentionUntil DateTime? @map("retention_until")
  policyVersion  String    @map("policy_version")
  createdAt      DateTime  @default(now()) @map("created_at")

  party Party @relation(fields: [partyId], references: [id])

  @@map("consent_record")
}

enum MandateState {
  pending
  verified
  rejected
}

/// Authority = a lister's right to market a SPECIFIC property (FR-3.2, FR-3.3).
/// A (lister, property) pair. This is what an unmandated broker listing lacks.
/// Enforcement (stated in Data_Model.md §2.7, for the Listings module): a
/// broker_agent or property_mgmt_company listing cannot transition to 'live'
/// unless a 'verified' mandate exists for (its lister, its property).
/// property_owner listings do not require a mandate row in V1.
model PropertyMandate {
  id                String       @id @default(uuid())
  listerPartyId     String       @map("lister_party_id")
  propertyId        String       @map("property_id")
  evidenceMediaId   String?      @map("evidence_media_id")
  state             MandateState @default(pending)
  verifiedByPartyId String?      @map("verified_by_party_id")
  verifiedAt        DateTime?    @map("verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  listerParty     Party       @relation("MandateLister", fields: [listerPartyId], references: [id])
  verifiedByParty Party?      @relation("MandateVerifier", fields: [verifiedByPartyId], references: [id])
  property        Property    @relation(fields: [propertyId], references: [id])
  evidenceMedia   MediaAsset? @relation(fields: [evidenceMediaId], references: [id])

  @@unique([listerPartyId, propertyId])
  @@map("property_mandate")
}

// ============================================================================
// Config module (Data_Model.md §3) — versioned, effective-dated
// ============================================================================

enum ConfigValueType {
  int
  json
  text
}

/// Generic versioned config for non-money parameters: service-area boundary,
/// freshness window (days), screening module set, required-months default.
model ConfigParameter {
  id        String          @id @default(uuid())
  key       String          @unique
  valueType ConfigValueType @map("value_type")
  createdAt DateTime        @default(now()) @map("created_at")

  versions ConfigVersion[]

  @@map("config_parameter")
}

/// 🔒 Immutable: a config change is a new version, never an edit. Current value
/// = latest version whose effective_from <= now() (FR-10.1).
model ConfigVersion {
  id               String   @id @default(uuid())
  parameterId      String   @map("parameter_id")
  value            Json
  effectiveFrom    DateTime @map("effective_from")
  createdByPartyId String   @map("created_by_party_id")
  createdAt        DateTime @default(now()) @map("created_at")

  parameter      ConfigParameter @relation(fields: [parameterId], references: [id])
  createdByParty Party           @relation(fields: [createdByPartyId], references: [id])

  @@index([parameterId, effectiveFrom])
  @@map("config_version")
}

/// 🔒 Immutable. Commission rate is money-touching, so it gets its own explicit
/// versioned table (Technical Architecture §4.1) rather than living in the
/// generic config_version table. Rate is expressed as basis points of ONE
/// MONTH's rent (10000 bp = 1.0 month) so commission math is pure integer
/// arithmetic: commission = monthly_rent * rate_bp_of_month / 10000. The
/// default V1 value (~10000 bp) is a config choice pending landlord
/// validation (SSOT Decision 4) — changing it creates a NEW version and never
/// mutates an existing one; in-flight deals hold a snapshot (see Deal below),
/// making them structurally immune to the change (FR-7.4).
model CommissionRateVersion {
  id               String   @id @default(uuid())
  rateBpOfMonth    Int      @map("rate_bp_of_month")
  effectiveFrom    DateTime @map("effective_from")
  createdByPartyId String   @map("created_by_party_id")
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")

  createdByParty Party @relation(fields: [createdByPartyId], references: [id])

  deals             Deal[]
  listingAgreements ListingAgreement[]

  @@index([effectiveFrom])
  @@map("commission_rate_version")
}

// ============================================================================
// Listings & Properties module (Data_Model.md §4)
// ============================================================================

/// Taxonomy-first location (FR-2.2). Hierarchical to allow corridor grouping.
/// Corridor membership is a DATA FLAG (in_service_area), not code (FR-2.5).
/// The authoritative service-area definition lives in Config ('service_area');
/// this flag is its materialised projection for query performance.
model Neighbourhood {
  id            String   @id @default(uuid())
  name          String
  parentId      String?  @map("parent_id")
  inServiceArea Boolean  @default(false) @map("in_service_area")
  createdAt     DateTime @default(now()) @map("created_at")

  parent   Neighbourhood?  @relation("NeighbourhoodHierarchy", fields: [parentId], references: [id])
  children Neighbourhood[] @relation("NeighbourhoodHierarchy")

  properties Property[]

  @@map("neighbourhood")
}

enum PropertyType {
  apartment
  house
  room
  other
}

enum FurnishedState {
  furnished
  semi_furnished
  unfurnished
}

/// ⟡ transaction_type is a single-value enum in V1 ('rental' only). Adding
/// 'sale' is a Postgres enum ADD VALUE, which does not migrate or invalidate
/// existing rows — seam preserved without building sale logic (FR-2.4, SSOT
/// Decision 6).
enum TransactionType {
  rental
}

/// street_address is OPTIONAL and never required (FR-2.2) — location is
/// neighbourhood-taxonomy-first with a map pin + landmark.
model Property {
  id              String          @id @default(uuid())
  ownerPartyId    String          @map("owner_party_id")
  propertyType    PropertyType    @map("property_type")
  bedrooms        Int
  bathrooms       Int
  furnished       FurnishedState
  neighbourhoodId String          @map("neighbourhood_id")
  geoLat          Float?          @map("geo_lat")
  geoLng          Float?          @map("geo_lng")
  landmarkText    String          @map("landmark_text")
  streetAddress   String?         @map("street_address")
  transactionType TransactionType @default(rental) @map("transaction_type")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  ownerParty    Party         @relation(fields: [ownerPartyId], references: [id])
  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id])

  mandates PropertyMandate[]
  listings Listing[]

  /// KYC applications that cite this property for the ownership/authority
  /// review (additive, 2026-10-29). Optional: an applicant may describe a
  /// property they have not registered yet.
  landlordKycSubmissions LandlordKyc[]

  @@map("property")
}

/// ⟡ tier is single-value in V1 ('standard' only) — seam for premium
/// operations (SSOT Decision 1). Availability freshness: a listing is STALE
/// when now() - availability_confirmed_at > freshness_window (window from
/// Config) — staleness is COMPUTED, not stored, so the window can change by
/// config alone (FR-2.3).
///
/// Invariant (enforced at the publish transition, not by DB constraint alone,
/// since it depends on lister tier + mandate state which live in other
/// tables): publication_state = 'live' requires verification_state =
/// 'verified' AND, for broker/mgmt listers, a verified property_mandate.
enum ListingTier {
  standard
}

enum PublicationState {
  draft
  awaiting_verification
  live
  rented
  withdrawn
}

enum ListingVerificationState {
  unverified
  verified
}

enum AvailabilityStatus {
  available
  unavailable
}

model Listing {
  id                      String                   @id @default(uuid())
  propertyId              String                   @map("property_id")
  monthlyRent             BigInt                   @map("monthly_rent")
  requiredMonthsUpfront   Int                      @map("required_months_upfront")
  depositAmount           BigInt                   @map("deposit_amount")
  /// Recorded mutual agreement between landlord and tenant for advance rent
  /// ABOVE THREE MONTHS (approved policy 2026-10-30). Free-text reference or
  /// evidence id; terms > 3 months are refused without it, and the reference
  /// is snapshotted onto any deal signed against these terms.
  advanceMutualAgreementRef String?                @map("advance_mutual_agreement_ref")
  tier                    ListingTier              @default(standard)
  publicationState        PublicationState         @default(draft) @map("publication_state")
  verificationState       ListingVerificationState @default(unverified) @map("verification_state")
  availabilityStatus      AvailabilityStatus       @default(available) @map("availability_status")
  availabilityConfirmedAt DateTime?                @map("availability_confirmed_at")
  descriptionText         String?                  @map("description_text")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])

  listingAmenities    ListingAmenity[]
  viewings            Viewing[]
  introductionRecords IntroductionRecord[]
  deals               Deal[]
  listingAgreements   ListingAgreement[]
  photos              ListingPhoto[]
  savedBy             SavedListing[]

  @@map("listing")
}

model Amenity {
  id   String @id @default(uuid())
  name String @unique

  listingAmenities ListingAmenity[]

  @@map("amenity")
}

model ListingAmenity {
  listingId String @map("listing_id")
  amenityId String @map("amenity_id")

  listing Listing @relation(fields: [listingId], references: [id])
  amenity Amenity @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
  @@map("listing_amenity")
}

// ============================================================================
// Viewings & Field Ops module (Data_Model.md §5)
// ============================================================================

/// ⟡ conducted_by_role is 'foo'-only in V1 (FR-5.6 seam). Adding
/// 'certified_partner' is an enum extension; existing rows unaffected.
///
/// Invariant (enforced at the transition, see Stage 1/5 services): a viewing
/// cannot move to 'conducted' without (a) an introduction_record and (b) a
/// field_report (FR-5.3, FR-5.4).
enum ConductedByRole {
  foo
}

enum ViewingStatus {
  requested
  scheduled
  conducted
  no_show
  cancelled
}

model Viewing {
  id                 String          @id @default(uuid())
  listingId          String          @map("listing_id")
  tenantPartyId      String          @map("tenant_party_id")
  conductedByPartyId String?         @map("conducted_by_party_id")
  conductedByRole    ConductedByRole @default(foo) @map("conducted_by_role")
  scheduledFor       DateTime        @map("scheduled_for")
  status             ViewingStatus   @default(requested)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  listing          Listing @relation(fields: [listingId], references: [id])
  tenantParty      Party   @relation("ViewingTenant", fields: [tenantPartyId], references: [id])
  conductedByParty Party?  @relation("ViewingFoo", fields: [conductedByPartyId], references: [id])

  introductionRecord IntroductionRecord?
  fieldReport        FieldReport?

  @@map("viewing")
}

/// 🔒 Immutable — this is evidence. The timestamped tenant<->property<->
/// landlord<->FOO linkage that makes the circumvention clause enforceable
/// (FR-5.3, FR-8.3, SSOT Decision 11). Persists independently of the deal — a
/// bypassed deal (no deal record) still leaves this evidence.
model IntroductionRecord {
  id              String   @id @default(uuid())
  viewingId       String   @unique @map("viewing_id")
  tenantPartyId   String   @map("tenant_party_id")
  listingId       String   @map("listing_id")
  landlordPartyId String   @map("landlord_party_id")
  fooPartyId      String   @map("foo_party_id")
  introducedAt    DateTime @map("introduced_at")
  createdAt       DateTime @default(now()) @map("created_at")

  viewing       Viewing @relation(fields: [viewingId], references: [id])
  tenantParty   Party   @relation("IntroTenant", fields: [tenantPartyId], references: [id])
  landlordParty Party   @relation("IntroLandlord", fields: [landlordPartyId], references: [id])
  fooParty      Party   @relation("IntroFoo", fields: [fooPartyId], references: [id])
  listing       Listing @relation(fields: [listingId], references: [id])

  deals Deal[]

  @@map("introduction_record")
}

enum ConditionRating {
  excellent
  good
  fair
  poor
}

/// Structured, not free-text-only (FR-5.4). condition_rating and
/// matches_listing are structured fields precisely so they become baseline
/// data for future Certified Partner standards (SSOT Decision 9) — you can't
/// certify against a standard you never measured.
model FieldReport {
  id              String          @id @default(uuid())
  viewingId       String          @unique @map("viewing_id")
  fooPartyId      String          @map("foo_party_id")
  conditionRating ConditionRating @map("condition_rating")
  matchesListing  Boolean         @map("matches_listing")
  isAvailable     Boolean         @map("is_available")
  issuesText      String?         @map("issues_text")
  timingNote      String?         @map("timing_note")
  mediaAssetIds   String[]        @map("media_asset_ids")
  reportedAt      DateTime        @map("reported_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  viewing  Viewing @relation(fields: [viewingId], references: [id])
  fooParty Party   @relation(fields: [fooPartyId], references: [id])

  @@map("field_report")
}

// ============================================================================
// Screening module (Data_Model.md §6) — modular pipeline
// ============================================================================

enum ScreeningOverallState {
  pending
  passed
  failed
}

/// The pipeline is data-driven: which modules run comes from Config
/// ('screening_modules'); V1 = ['identity']. module_set snapshots what
/// actually ran on this run, so history stays interpretable after config
/// changes (FR-6.1, FR-6.2).
model ScreeningRun {
  id            String                @id @default(uuid())
  tenantPartyId String                @map("tenant_party_id")
  dealId        String?               @map("deal_id")
  overallState  ScreeningOverallState @default(pending) @map("overall_state")
  moduleSet     Json                  @map("module_set")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  tenantParty Party @relation(fields: [tenantPartyId], references: [id])
  deal        Deal? @relation(fields: [dealId], references: [id])

  moduleResults ScreeningModuleResult[]

  @@map("screening_run")
}

enum ScreeningModuleState {
  pending
  passed
  failed
  skipped
}

/// Adding a future module = a new module_key value + a new pipeline module;
/// NO schema change here, and no change to the tenant flow (FR-6.2). Ability-
/// to-pay is NOT a screening module — it's evidenced by escrow funding
/// (FR-6.3); no employment/financial documents are modelled anywhere in V1.
model ScreeningModuleResult {
  id             String               @id @default(uuid())
  screeningRunId String               @map("screening_run_id")
  moduleKey      String               @map("module_key")
  state          ScreeningModuleState
  detail         Json?
  createdAt      DateTime             @default(now()) @map("created_at")

  screeningRun ScreeningRun @relation(fields: [screeningRunId], references: [id])

  @@map("screening_module_result")
}

// ============================================================================
// Deals & Guarantee module (Data_Model.md §7) — the spine
// ============================================================================

/// One authoritative status; explicit transitions only; illegal transitions
/// rejected (FR-8.1). §7.3's transition table is the state machine — the
/// service layer exposes only the transitions listed there.
///
/// Move-In Guarantee (FR-8.2), stated as a structural fact: there is NO
/// transition from escrow_funded to settled. The only exits from
/// escrow_funded are move_in_confirmed (forward) or refunded (money back).
/// Funds are therefore unreleasable until move-in — the guarantee is the
/// SHAPE OF THE GRAPH, needing no reserve fund.
///
/// 2026-10-30 financial-architecture extension (ALL ADDITIVE — no existing
/// value changed meaning, no row migrates):
///   payment_pending                  live collection in flight on the PSP
///   move_in_awaiting_verification    the evidence-based move-in window
///   move_in_disputed                 conflicting handover evidence
///   settlement_pending               landlord payout instructed, unconfirmed
///   refund_pending                   tenant refund instructed, unconfirmed
///   partially_refunded               some rent refunded; the deal continues
///   financial_review_required        a money-guard anomaly awaits ops
///   reversed                         provider clawed a confirmed payment back
/// commission_earned stays for deals signed before commission moved to
/// confirmed-payment; it is no longer on the primary path (see
/// docs/FINANCIAL_ARCHITECTURE.md §7).
enum DealStatus {
  created
  tenant_matched
  agreement_signed
  escrow_funded
  move_in_confirmed
  commission_earned
  settled
  closed
  cancelled
  refunded
  dispute_hold
  payment_pending
  move_in_awaiting_verification
  move_in_disputed
  settlement_pending
  refund_pending
  partially_refunded
  financial_review_required
  reversed
}

model Deal {
  id                   String     @id @default(uuid())
  listingId            String     @map("listing_id")
  tenantPartyId        String     @map("tenant_party_id")
  landlordPartyId      String     @map("landlord_party_id")
  introductionRecordId String?    @map("introduction_record_id")
  status               DealStatus @default(created)

  // SNAPSHOTTED at agreement_signed, immutable thereafter (FR-7.4). A later
  // change to the listing's rent or to commission_rate_version cannot alter
  // an in-flight deal — immunity is structural, not disciplinary.
  //
  // 2026-10-30 extension: the ACCEPTED FINANCIAL TERMS are now snapshotted in
  // full (advance months, total advance rent, deposit, commission payer, the
  // >3-months mutual-agreement reference and the policy tokens in force at
  // acceptance). Funding derives EVERY figure from these columns — a later
  // listing edit can no longer re-price months or deposit either
  // (docs/FINANCIAL_ARCHITECTURE.md G-1). Rows with these columns null are
  // legacy deals and keep the pre-extension behaviour exactly.
  monthlyRentSnapshot         BigInt? @map("monthly_rent_snapshot")
  commissionRateBpSnapshot    Int?    @map("commission_rate_bp_snapshot")
  commissionRateVersionId     String? @map("commission_rate_version_id")
  advanceMonthsSnapshot       Int?    @map("advance_months_snapshot")
  advanceRentSnapshot         BigInt? @map("advance_rent_snapshot")
  depositAmountSnapshot       BigInt? @map("deposit_amount_snapshot")
  commissionPayerSnapshot     String? @map("commission_payer_snapshot")
  mutualAgreementRefSnapshot  String? @map("mutual_agreement_ref_snapshot")
  policySnapshot              Json?   @map("policy_snapshot")

  // Derived, stored at earn time. commission_amount =
  // monthly_rent_snapshot * commission_rate_bp_snapshot / 10000, integer
  // arithmetic, computed at commission_earned — never from escrow total,
  // never from a live rate (FR-7.3).
  commissionAmount BigInt? @map("commission_amount")
  agreementId      String? @map("agreement_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing               Listing                @relation(fields: [listingId], references: [id])
  tenantParty           Party                  @relation("DealTenant", fields: [tenantPartyId], references: [id])
  landlordParty         Party                  @relation("DealLandlord", fields: [landlordPartyId], references: [id])
  introductionRecord    IntroductionRecord?    @relation(fields: [introductionRecordId], references: [id])
  commissionRateVersion CommissionRateVersion? @relation(fields: [commissionRateVersionId], references: [id])
  agreement             ListingAgreement?      @relation(fields: [agreementId], references: [id])

  transitions     DealTransition[]
  ledgerAccounts  LedgerAccount[]
  ledgerEntries   LedgerEntry[]
  pspInstructions PspInstruction[]
  screeningRuns   ScreeningRun[]
  moveInVerification MoveInVerification?
  depositCase        DepositCase?
  refundRecords      RefundRecord[]
  financialAdjustments FinancialAdjustment[]
  postSettlementRefunds PostSettlementRefund[]

  @@map("deal")
}

/// 🔒 Explicit, auditable state history. One authoritative status on Deal;
/// full history here.
model DealTransition {
  id           String   @id @default(uuid())
  dealId       String   @map("deal_id")
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  actorPartyId String   @map("actor_party_id")
  reason       String?
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  deal       Deal  @relation(fields: [dealId], references: [id])
  actorParty Party @relation(fields: [actorPartyId], references: [id])

  @@map("deal_transition")
}

// ============================================================================
// Payments module (Data_Model.md §8) — double-entry ledger & PSP boundary
// ============================================================================

/// Typed accounts (Technical Architecture §5.1). Product-agnostic: no
/// "rent"/"commission" as columns — meaning comes from account_type.
///
/// 2026-10-30 additive classification (docs/FINANCIAL_ARCHITECTURE.md §3):
///   rent_escrow_liability — the RENT side of client money held (the
///     deposit is no longer lumped into one generic escrow balance)
///   deposit_liability     — the deposit side, its own lifecycle
///   psp_fee_expense       — provider processing fees borne by HFR
///     (operating expense; never deducted from a tenant's deposit or
///     silently added to a tenant's payment)
/// escrow_liability remains the classification of every deal funded before
/// the split — legacy deals are never rewritten.
enum LedgerAccountType {
  escrow_liability
  commission_receivable
  commission_revenue
  landlord_payable
  psp_clearing
  rent_escrow_liability
  deposit_liability
  psp_fee_expense
}

model LedgerAccount {
  id           String            @id @default(uuid())
  accountType  LedgerAccountType @map("account_type")
  ownerPartyId String?           @map("owner_party_id")
  dealId       String?           @map("deal_id")
  currency     String            @default("UGX")
  createdAt    DateTime          @default(now()) @map("created_at")

  ownerParty Party? @relation(fields: [ownerPartyId], references: [id])
  deal       Deal?  @relation(fields: [dealId], references: [id])

  entries LedgerEntry[]

  @@map("ledger_account")
}

enum LedgerDirection {
  debit
  credit
}

/// 🔒 Immutable, balanced postings. The single source of financial truth.
///
/// Invariants (enforced in code within the DB transaction, FR-7.2):
///   - For a given posting_id, sum(debits) = sum(credits). Unbalanced ->
///     rejected before commit.
///   - No UPDATE/DELETE on any row. Corrections = a new reversing posting_id.
///   - amount > 0 always; direction carries the sign.
///   - Money is BigInt; no float anywhere.
///
/// Canonical postings (Data_Model.md §8.2):
///   fund_escrow:          debit psp_clearing,      credit escrow_liability
///   recognise_commission: debit escrow_liability,  credit commission_revenue
///   settle:               debit escrow_liability,  credit landlord_payable
///                         (+ PSP release: debit landlord_payable, credit psp_clearing)
///   refund:               debit escrow_liability,  credit psp_clearing
model LedgerEntry {
  id         String          @id @default(uuid())
  postingId  String          @map("posting_id")
  accountId  String          @map("account_id")
  direction  LedgerDirection
  amount     BigInt
  dealId     String?         @map("deal_id")
  reference  String?
  occurredAt DateTime        @map("occurred_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  account LedgerAccount @relation(fields: [accountId], references: [id])
  deal    Deal?         @relation(fields: [dealId], references: [id])

  @@index([postingId])
  @@index([accountId])
  @@map("ledger_entry")
}

enum PspInstructionKind {
  collect
  release
  refund
}

enum PspInstructionState {
  pending
  succeeded
  failed
}

/// 🔒 The idempotent boundary to the external custodian (Technical
/// Architecture §5.2). idempotency_key dedupes duplicate callbacks (FR-7.8).
///
/// FULLY immutable — the instruction as issued never changes. Its lifecycle
/// (pending → succeeded/failed) is recorded as PspInstructionEvent rows and
/// the current state is DERIVED from the latest event, not stored here.
/// The `state` column is retained only as the initial, permanent record of
/// how the instruction was created (always `pending`); read current state
/// via PspInstructionEvent. This keeps the amount, kind and idempotency key
/// of a money instruction un-editable after the fact, which is the point of
/// marking this table immutable in the first place.
model PspInstruction {
  id             String              @id @default(uuid())
  dealId         String              @map("deal_id")
  kind           PspInstructionKind
  amount         BigInt
  idempotencyKey String              @unique @map("idempotency_key")
  providerRef    String?             @map("provider_ref")
  state          PspInstructionState @default(pending)
  createdAt      DateTime            @default(now()) @map("created_at")

  deal   Deal                  @relation(fields: [dealId], references: [id])
  events PspInstructionEvent[]

  @@map("psp_instruction")
}

/// 🔒 Append-only lifecycle log for a psp_instruction. The instruction's
/// CURRENT state is the `toState` of its most recent event (or `pending` if
/// it has none). Duplicate provider callbacks are deduplicated on
/// (instruction, toState) so a repeated "succeeded" webhook cannot post
/// twice (FR-7.8).
model PspInstructionEvent {
  id            String              @id @default(uuid())
  instructionId String              @map("instruction_id")
  toState       PspInstructionState @map("to_state")
  providerRef   String?             @map("provider_ref")
  detail        String?
  occurredAt    DateTime            @map("occurred_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  instruction PspInstruction @relation(fields: [instructionId], references: [id])

  @@unique([instructionId, toState])
  @@index([instructionId])
  @@map("psp_instruction_event")
}

/// Ledger-vs-PSP reconciliation (FR-7.8, FR-10.4).
model ReconciliationCheck {
  id              String   @id @default(uuid())
  runAt           DateTime @map("run_at")
  ledgerBalance   BigInt   @map("ledger_balance")
  pspBalance      BigInt   @map("psp_balance")
  isReconciled    Boolean  @map("is_reconciled")
  discrepancyNote String?  @map("discrepancy_note")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("reconciliation_check")
}

// ============================================================================
// Agreements module (Data_Model.md §9)
// ============================================================================

/// 🔒 Originates the rate snapshot (FR-9.1). Immutable once accepted. At
/// acceptance, the deal copies commission_rate_version.rate_bp_of_month ->
/// deal.commission_rate_bp_snapshot and monthly_rent_at_signing ->
/// deal.monthly_rent_snapshot. Names the LANDLORD as payer (FR-9.2);
/// tenant-facing surfaces carry no charge.
model ListingAgreement {
  id                         String    @id @default(uuid())
  listingId                  String    @map("listing_id")
  listerPartyId              String    @map("lister_party_id")
  commissionRateVersionId    String    @map("commission_rate_version_id")
  monthlyRentAtSigning       BigInt    @map("monthly_rent_at_signing")
  circumventionClauseVersion String    @map("circumvention_clause_version")
  acceptedAt                 DateTime? @map("accepted_at")
  accepted                   Boolean   @default(false)
  createdAt                  DateTime  @default(now()) @map("created_at")

  listing               Listing               @relation(fields: [listingId], references: [id])
  listerParty           Party                 @relation(fields: [listerPartyId], references: [id])
  commissionRateVersion CommissionRateVersion @relation(fields: [commissionRateVersionId], references: [id])

  deals Deal[]

  @@map("listing_agreement")
}

// ============================================================================
// Media & Audit (Data_Model.md §10)
// ============================================================================

enum MediaKind {
  image
  video
}

/// Derived renditions of a photograph. `original` is NOT a variant — the
/// untouched upload keeps living at MediaAsset.storageRef (private, never
/// served to a browser). Variants are re-encoded WebP derivatives.
enum MediaVariantName {
  thumb
  card
  detail
}

model MediaAsset {
  id                String    @id @default(uuid())
  storageRef        String    @map("storage_ref")
  kind              MediaKind
  perceptualHash    String?   @map("perceptual_hash")
  uploadedByPartyId String    @map("uploaded_by_party_id")
  /// The MIME type actually stored. Nullable because rows written by the
  /// V1 mock capture path predate byte storage and have no file behind them.
  mimeType          String?   @map("mime_type")
  byteSize          Int?      @map("byte_size")
  createdAt         DateTime  @default(now()) @map("created_at")

  uploadedByParty Party @relation(fields: [uploadedByPartyId], references: [id])

  propertyMandates PropertyMandate[]
  listingPhotos    ListingPhoto[]
  variants         MediaVariant[]

  /// KYC evidence slots (additive, 2026-10-29). A decided review's evidence
  /// is part of the record: RESTRICT on delete makes removing bytes while a
  /// decided submission still cites them impossible (the detach-then-delete
  /// path in src/server/kyc.ts is the only way, and only while open).
  kycIdFrontSlots           LandlordKyc[] @relation("KycIdFront")
  kycIdBackSlots            LandlordKyc[] @relation("KycIdBack")
  kycSelfieSlots            LandlordKyc[] @relation("KycSelfie")
  kycOwnershipEvidenceSlots LandlordKyc[] @relation("KycOwnershipEvidence")

  @@map("media_asset")
}

/// One derived rendition of a MediaAsset (2026-10-27 image pipeline).
///
/// ── What lives here and what deliberately does not ──
/// Storage KEYS, variant name, pixel dimensions, byte size and content type —
/// the metadata the serving route needs to pick and deliver the right bytes.
/// Never image bytes themselves: those live in the private object store under
/// storage_ref, exactly like the original.
///
/// ── processing_status ──
/// 'ready' is the only state the serving route trusts; a 'failed' row is kept
/// for diagnosis and the route falls back to the original bytes for that
/// variant until reprocessing succeeds.
///
/// ── Lifecycle ──
/// Rows are created in the SAME transaction as their asset (with the bytes
/// stored first and compensated away if the transaction fails — the same
/// contract as the original), and CASCADE on asset delete so a deleted
/// photograph cannot leave orphan renditions behind.
model MediaVariant {
  id               String           @id @default(uuid())
  mediaAssetId     String           @map("media_asset_id")
  variant          MediaVariantName
  storageRef       String           @map("storage_ref")
  mimeType         String           @map("mime_type")
  width            Int
  height           Int
  byteSize         Int              @map("byte_size")
  processingStatus String           @default("ready") @map("processing_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  /// CASCADE is the contract the delete path relies on: removing an asset
  /// removes its rendition metadata in the same statement (the stored
  /// objects are compensated separately in code). Without this attribute
  /// Prisma's default for a required relation is RESTRICT — which would
  /// contradict prisma/migrations/20261027120000_media_variants
  /// (ON DELETE CASCADE) and make every schema-generated DDL disagree
  /// with the migration actually applied to production.
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, variant])
  @@index([mediaAssetId])
  @@map("media_variant")
}

/// A photograph shown on a listing (FR-4.2 — the property is the evidence).
///
/// ── Why this is a table and not a column on Listing ──
/// A listing has many photographs, they are ordered, and each one carries
/// its own provenance. Provenance is the point: `source` records whether a
/// human being from this platform stood in that room. A tenant deciding
/// whether to spend a Saturday travelling to Kira is entitled to know
/// whether the picture was taken by our field officer or supplied by the
/// person trying to let the property — and a development fixture must be
/// able to say so out loud rather than pass as either.
enum PhotoSource {
  /// Captured by a Field Operations Officer during a verification visit.
  /// The only value that may be presented as verified photography.
  field_officer
  /// Supplied by the lister. Shown, but never described as verified.
  lister
  /// Seeded demonstration imagery. NOT a real property on this platform.
  /// The API marks it and every surface must label it.
  development_fixture
}

model ListingPhoto {
  id           String      @id @default(uuid())
  listingId    String      @map("listing_id")
  mediaAssetId String      @map("media_asset_id")
  sortOrder    Int         @default(0) @map("sort_order")
  caption      String?
  source       PhotoSource
  createdAt    DateTime    @default(now()) @map("created_at")

  listing    Listing    @relation(fields: [listingId], references: [id])
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([listingId, mediaAssetId])
  @@index([listingId, sortOrder])
  @@map("listing_photo")
}

/// 🔒 Append-only (NFR-2). Money, verification, consent, config-change
/// events.
model AuditEvent {
  id           String   @id @default(uuid())
  eventType    String   @map("event_type")
  actorPartyId String   @map("actor_party_id")
  subjectRef   String?  @map("subject_ref")
  payload      Json?
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  actorParty Party @relation(fields: [actorPartyId], references: [id])

  @@map("audit_event")
}

// ============================================================================
// Saved homes (additive, sandbox-era product feature carried into production)
// ============================================================================

/// A tenant's bookmarked listings. The production database shipped without
/// this table; it was added ADDITIVELY (CREATE TABLE IF NOT EXISTS, no
/// pre-existing table touched) so the product's save feature keeps working.
model SavedListing {
  id        String   @id @default(uuid())
  partyId   String   @map("party_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  party   Party   @relation(fields: [partyId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([partyId, listingId])
  // Declared 2026-10-23 to match the production index that already exists on
  // listing_id (found by the Gate-1 schema-parity diff; additive, no push).
  @@index([listingId])
  @@map("saved_listing")
}

// ============================================================================
// Landlord onboarding KYC (additive, consolidated round 2026-10-29)
// ============================================================================

enum KycIdDocumentType {
  /// The standard path: a Ugandan National ID (front + back) + a selfie —
  /// the intended workflow for eligible Ugandan citizens.
  national_id
  /// The documented exception: a passport, permit or other evidence for a
  /// person who cannot hold a Ugandan National ID. Never treated as a
  /// rejection or an auto-approval — every review surface marks it for
  /// owner review rather than inventing an eligibility rule in code.
  other_document
}

enum KycRelationship {
  /// Lists a property they own.
  owner
  /// Markets the property for someone else. Per the EXISTING publication
  /// rule, such a listing cannot go live without a verified per-property
  /// mandate — this application does not change that.
  broker_agent
  /// Another association with the property (family, caretaker, ...).
  other_associated
}

enum KycReviewState {
  /// Waiting for a reviewer. The applicant may still edit an open section.
  pending
  /// A reviewer asked for more information; the applicant resubmits.
  more_info
  approved
  rejected
}

enum KycPayoutMethod {
  /// The ONLY method the actual provider integration supports today:
  /// the NylonPay collection API takes a mobile-money phone number. A
  /// bank-transfer option would invent a provider capability that has
  /// never been shown (DPA: collect only what the rails actually need).
  mobile_money
}

/// A landlord's onboarding application. One row per submission episode
/// (a rejected application's successor is a NEW row — history is the rows
/// plus their audit events, never an edit). Three INDEPENDENT section
/// states: identity, ownership/authority, payout — a single approved
/// boolean here would erase the distinctions the platform's rules are
/// built on (identity ≠ authority ≠ payout ≠ listing publication ≠
/// field verification, each of which keeps its own state elsewhere).
///
/// ── What approval here does and does not mean ──
/// Identity approval records a MANUAL review of submitted documents. The
/// platform runs no independent identity verification (the NIN provider
/// is a disclosed sandbox mock) — no surface may claim otherwise.
/// Authority approval records a review of a DECLARED relationship; a
/// broker or associated person is never recorded as the property owner.
/// Payout approval verifies payment DETAILS only; real-money movement
/// stays disabled until the provider (NylonPay merchant KYC) and legal
/// prerequisites close — an external blocker, unchanged.
model LandlordKyc {
  id      String @id @default(uuid())
  partyId String @map("party_id")

  // ── identity section ──
  legalName          String            @map("legal_name")
  idDocumentType     KycIdDocumentType @default(national_id) @map("id_document_type")
  /// The applicant's age-eligibility declaration (18+, consistent with the
  /// National ID path). A claim on the record — not an independent check.
  ageConfirmed       Boolean           @default(false) @map("age_confirmed")
  idFrontMediaId     String?           @map("id_front_media_id")
  idBackMediaId      String?           @map("id_back_media_id")
  selfieMediaId      String?           @map("selfie_media_id")
  identityState      KycReviewState    @default(pending) @map("identity_state")
  identityReviewNote String?           @map("identity_review_note")

  // ── ownership / authority section ──
  relationship             KycRelationship @default(owner)
  /// Optional link to an existing property record for context. The
  /// property/ownership system of record stays exactly where it was;
  /// this is a reference for the reviewer, not a transfer of anything.
  propertyId               String?         @map("property_id")
  /// Title particulars / property details as declared by the applicant.
  titleParticulars         String?         @map("title_particulars")
  ownershipEvidenceMediaId String?         @map("ownership_evidence_media_id")
  /// Up to four property photograph asset ids (Json array — primitives
  /// cannot be lists in this schema; the ids are validated on write).
  propertyPhotos           Json?           @map("property_photos")
  /// Required for broker_agent / other_associated: the authority story.
  authorityExplanation     String?         @map("authority_explanation")
  authorityState           KycReviewState  @default(pending) @map("authority_state")
  authorityReviewNote      String?         @map("authority_review_note")

  // ── payout section (verification of DETAILS only) ──
  payoutRecipientName String?          @map("payout_recipient_name")
  payoutMethod        KycPayoutMethod? @map("payout_method")
  /// Mobile-money destination, stored as the normalized +256 number. No
  /// PINs, no passwords, no OTPs — those are never KYC information.
  payoutDestination   String?          @map("payout_destination")
  payoutState         KycReviewState   @default(pending) @map("payout_state")
  payoutReviewNote    String?          @map("payout_review_note")

  // ── declarations + terms ──
  /// The accountability declarations the applicant checked, stored as
  /// { identityAccurate, relationshipHonest, authorityDisclosed,
  ///   accuracyOngoing, agreeTerms } — server-validated before submit.
  declarations Json
  /// The exact landlord-onboarding terms version accepted (also recorded
  /// as a ConsentRecord — this column keeps the application self-describing).
  termsVersion String @map("terms_version")

  // ── lifecycle ──
  submittedAt           DateTime  @default(now()) @map("submitted_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  /// The most recent reviewer (display convenience; the authoritative
  /// history is the audit trail — every decision is an append-only row).
  lastReviewedByPartyId String?   @map("last_reviewed_by_party_id")
  lastReviewedAt        DateTime? @map("last_reviewed_at")

  party                  Party       @relation("KycApplicant", fields: [partyId], references: [id])
  property               Property?   @relation(fields: [propertyId], references: [id])
  // Evidence FKs RESTRICT on delete: a decided review's evidence is part of
  // the record, and nothing (not even a raw DELETE) may silently detach it.
  // The detach-then-delete path in src/server/kyc.ts is the only way to
  // remove evidence, and only while the application is still open.
  idFrontMedia           MediaAsset? @relation("KycIdFront", fields: [idFrontMediaId], references: [id], onDelete: Restrict)
  idBackMedia            MediaAsset? @relation("KycIdBack", fields: [idBackMediaId], references: [id], onDelete: Restrict)
  selfieMedia            MediaAsset? @relation("KycSelfie", fields: [selfieMediaId], references: [id], onDelete: Restrict)
  ownershipEvidenceMedia MediaAsset? @relation("KycOwnershipEvidence", fields: [ownershipEvidenceMediaId], references: [id], onDelete: Restrict)
  lastReviewedBy         Party?      @relation("KycReviewer", fields: [lastReviewedByPartyId], references: [id])

  @@index([partyId, submittedAt])
  @@index([identityState])
  @@index([authorityState])
  @@index([payoutState])
  @@map("landlord_kyc")
}

// ============================================================================
// Better Auth (Technical Architecture — auth provider evaluation)
// ============================================================================

// ============================================================================
// Financial lifecycle models (additive, 2026-10-30) — the workflow records
// behind the ledger. The ledger remains the single money truth; these tables
// carry WHO decided WHAT, WHEN, WHY and with WHICH evidence, for the
// multi-party lifecycles a posting alone cannot express.
// docs/FINANCIAL_ARCHITECTURE.md §2–§6.
// ============================================================================

/// Move-in verification: evidence-based handover confirmation. Silence never
/// auto-confirms and never blocks indefinitely — an authorized reviewer
/// decides, and the decision (with its reason) is recorded here and audited.
/// The response window is POLICY-PENDING: `response_deadline` stays NULL
/// (and unenforced) until the business approves `movein_response_window_hours`.
enum MoveInVerificationState {
  open
  tenant_confirmed
  landlord_confirmed
  disputed
  under_review
  verified
  not_verified
}

model MoveInVerification {
  id                  String                   @id @default(uuid())
  dealId              String                   @unique @map("deal_id")
  state               MoveInVerificationState  @default(open)

  tenantConfirmedAt   DateTime? @map("tenant_confirmed_at")
  tenantNote          String?   @map("tenant_note")
  tenantEvidenceRef   String?   @map("tenant_evidence_ref")
  landlordConfirmedAt DateTime? @map("landlord_confirmed_at")
  landlordNote        String?   @map("landlord_note")
  landlordEvidenceRef String?   @map("landlord_evidence_ref")

  disputedByPartyId   String?   @map("disputed_by_party_id")
  disputeReason       String?   @map("dispute_reason")
  disputeEvidenceRef  String?   @map("dispute_evidence_ref")
  disputeOpenedAt     DateTime? @map("dispute_opened_at")

  /// Set only when the approved `movein_response_window_hours` config exists.
  responseDeadline    DateTime? @map("response_deadline")

  decidedByPartyId    String?   @map("decided_by_party_id")
  decidedAt           DateTime? @map("decided_at")
  decisionReason      String?   @map("decision_reason")

  /// Officer evidence is welcome; settlement authority never follows it.
  officerEvidenceRef  String?   @map("officer_evidence_ref")
  officerEvidenceNote String?   @map("officer_evidence_note")
  officerEvidenceAt   DateTime? @map("officer_evidence_at")
  officerEvidenceBy   String?   @map("officer_evidence_by")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@map("move_in_verification")
}

/// The security deposit's independent lifecycle (docs/FINANCIAL_ARCHITECTURE.md §5).
/// One case per deal, opened in the funding transaction. The money itself is
/// the `deposit_liability` ledger balance; this record is the workflow.
enum DepositCaseState {
  held
  deduction_proposed
  under_review
  partially_released
  closed
}

model DepositCase {
  id        String          @id @default(uuid())
  dealId    String          @unique @map("deal_id")
  state     DepositCaseState @default(held)

  /// The collect instruction whose success put the deposit in custody.
  custodyBasisRef String?   @map("custody_basis_ref")
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  closedReason    String?   @map("closed_reason")

  deductions DepositDeduction[]
  deal       Deal               @relation(fields: [dealId], references: [id])

  @@map("deposit_case")
}

/// One landlord-proposed deduction. Partial proposals are first-class.
/// Normal wear and tear must not be charged to the tenant — that standard
/// lives in the review guidance (action consequence copy), and every review
/// decision records WHO approved it and WHY.
enum DepositDeductionState {
  proposed
  under_review
  accepted_by_tenant
  disputed_by_tenant
  approved
  rejected
  applied
  withdrawn
}

model DepositDeduction {
  id                 String                @id @default(uuid())
  caseId             String                @map("case_id")
  proposedByPartyId  String                @map("proposed_by_party_id")
  amount             BigInt
  reason             String
  evidenceRef        String?               @map("evidence_ref")
  state              DepositDeductionState @default(proposed)

  tenantRespondedAt  DateTime? @map("tenant_responded_at")
  tenantResponseNote String?   @map("tenant_response_note")
  reviewedByPartyId  String?   @map("reviewed_by_party_id")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewReason       String?   @map("review_reason")
  appliedPostingId   String?   @map("applied_posting_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  case DepositCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@map("deposit_deduction")
}

/// A refund request and its outcome — the record behind every refund posting.
/// Kinds distinguish why money went back; amounts are server-bounded; the
/// linked PSP instruction carries the idempotency key.
enum RefundKind {
  full_pre_settlement
  partial_pre_settlement
  duplicate_payment
  deposit_refund
  commission_reversal_payout
}

enum RefundState {
  pending
  confirmed
  failed
}

model RefundRecord {
  id                 String       @id @default(uuid())
  dealId             String       @map("deal_id")
  kind               RefundKind
  amount             BigInt
  state              RefundState  @default(pending)
  reason             String
  requestedByPartyId String       @map("requested_by_party_id")
  instructionId      String?      @map("instruction_id")
  /// duplicate_payment refunds only: the COLLECT instruction the provider
  /// double-collected under. The refund's own payout instruction stays in
  /// instruction_id; this names the original payment that was collected twice.
  duplicateOfInstructionId String? @map("duplicate_of_instruction_id")
  confirmedAt        DateTime?    @map("confirmed_at")
  failureReason      String?      @map("failure_reason")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@index([kind, state])
  @@index([duplicateOfInstructionId])
  @@map("refund_record")
}

/// The recorded decision behind a correction. Every adjustment names its
/// category; commission reversals are legal ONLY for the approved categories
/// (landlord failure to provide the property; provider payment reversal).
enum FinancialAdjustmentKind {
  commission_reversal
  provider_reversal
  correction
  fee_correction
}

model FinancialAdjustment {
  id              String                 @id @default(uuid())
  dealId          String                 @map("deal_id")
  kind            FinancialAdjustmentKind
  /// The approved category token for reversals (policy gate); free-form for
  /// corrections.
  reasonCategory  String?                @map("reason_category")
  reason          String
  amount          BigInt
  actorPartyId    String                 @map("actor_party_id")
  actorRole       String?                @map("actor_role")
  targetPostingId String?                @map("target_posting_id")
  resultingPostingId String?             @map("resulting_posting_id")
  evidenceRef     String?                @map("evidence_ref")
  createdAt       DateTime               @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@map("financial_adjustment")
}

/// Post-settlement unearned prepaid rent: the LANDLORD's contractual refund
/// responsibility, coordinated by HFR. This is deliberately NOT a ledger
/// account and NEVER an HFR liability — no artificial guarantee balance.
/// HFR records, coordinates, and maintains the financial trail; resolution
/// states name what ACTUALLY happened, not what is promised.
enum PostSettlementRefundState {
  recorded
  landlord_acknowledged
  coordinating
  resolved_paid_by_landlord
  resolved_waived_by_tenant
  escalated
}

model PostSettlementRefund {
  id                 String                    @id @default(uuid())
  dealId             String                    @map("deal_id")
  amountClaimed      BigInt                    @map("amount_claimed")
  reason             String
  requestedByPartyId String                    @map("requested_by_party_id")
  state              PostSettlementRefundState @default(recorded)

  landlordAcknowledgedAt DateTime? @map("landlord_acknowledged_at")
  landlordNote           String?   @map("landlord_note")
  evidenceRef            String?   @map("evidence_ref")
  resolutionNote         String?   @map("resolution_note")
  resolvedAt             DateTime? @map("resolved_at")
  resolvedByPartyId      String?   @map("resolved_by_party_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@map("post_settlement_refund")
}

// ── provider statement reconciliation (Phase 2, FINANCIAL_ARCHITECTURE.md §9) ──
//
// An IMPORTED provider statement (or transaction report) and its rows. This
// is the provider side of reconciliation: the internal reconciliation check
// compares our books to THEMSELVES and to our OWN instruction records; these
// tables are where an actual provider-reported truth lands, gets classified
// line by line, and stays - the import is append-only and its decisions are
// never overwritten by a later import.
//
// The provider column is deliberately a free token ('nylonpay' today). No
// provider API is integrated here: statements arrive as reviewed imports
// (JSON over the admin endpoint) until the business approves a live fetch.

enum ProviderStatementSource {
  manual_import
}

model ProviderStatement {
  id                String                  @id @default(uuid())
  provider          String                  @default("nylonpay")
  source            ProviderStatementSource @default(manual_import)

  /// Inclusive reporting period the statement covers, when the provider
  /// names one. A line outside the period is an import error, not silent.
  periodStart       DateTime?               @map("period_start")
  periodEnd         DateTime?               @map("period_end")

  importedByPartyId String                  @map("imported_by_party_id")
  note              String?

  /// Rows the import received (before any classification).
  lineCount         Int                     @default(0) @map("line_count")
  createdAt         DateTime                @default(now()) @map("created_at")

  lines ProviderStatementLine[]

  @@index([provider, createdAt])
  @@map("provider_statement")
}

/// What the provider says happened, one row per provider transaction.
enum ProviderLineKind {
  collection
  payout
  refund
  fee
  reversal
}

/// The verdict the classifier recorded for this line, frozen at import:
///   matched    - pairs with an internal instruction/posting of the same amount
///   mismatch   - pairs but the amounts (or states) disagree
///   duplicate  - a second provider line for a reference already matched
///   unexpected - no internal instruction/posting for this provider reference
///   unmatched  - internal object of the expected class exists but amounts
///                could not be paired within this statement (review)
enum ProviderLineMatchState {
  matched
  mismatch
  duplicate
  unexpected
  unmatched
}

model ProviderStatementLine {
  id                    String                 @id @default(uuid())
  statementId           String                 @map("statement_id")

  /// Position in the import (0-based): the classification verdicts must be
  /// deterministic - which row "first matched" a reference and which row is
  /// the duplicate can never depend on UUID ordering.
  lineSeq               Int                    @default(0) @map("line_seq")

  /// The provider's row identity (statement line / transaction id), unique
  /// within one statement import so re-importing the same file is refused.
  lineRef               String?                @map("line_ref")
  /// The transaction reference our system issued (PspInstruction.providerRef).
  providerRef           String                 @map("provider_ref")
  kind                  ProviderLineKind
  amount                BigInt
  currency              String                 @default("UGX")
  occurredAt            DateTime               @map("occurred_at")

  /// The classification verdict + what it paired against, preserved.
  matchState            ProviderLineMatchState @default(unmatched) @map("match_state")
  matchedInstructionId  String?                @map("matched_instruction_id")
  matchNote             String?                @map("match_note")

  /// Verbatim provider row, kept for audit (bounded by the import route).
  raw                   Json?

  statement ProviderStatement @relation(fields: [statementId], references: [id])

  @@unique([statementId, lineRef])
  @@index([statementId])
  @@index([providerRef])
  @@map("provider_statement_line")
}
